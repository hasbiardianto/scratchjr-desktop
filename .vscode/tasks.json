{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ScratchJr",
            "type": "shell",
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "set NODE_OPTIONS=--openssl-legacy-provider && npm run build"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Copy Web Bundle",
            "type": "shell",
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "del editions\\free\\src\\app.bundle.js 2>nul & copy src\\build\\bundles\\app.bundle.js editions\\free\\src\\app.bundle.js"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Copy",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build ScratchJr",
                "Copy Web Bundle"
            ],
            "problemMatcher": []
        },
        {
            "label": "Start ScratchJr Server",
            "type": "shell",
            "command": "python -m http.server 8000",
            "options": {
                "cwd": "${workspaceFolder}\\editions\\free\\src"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Serving HTTP on"
                }
            }
        },
        {
            "label": "Build Start Server",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build and Copy",
                "Start ScratchJr Server"
            ],
            "problemMatcher": []
        }
    ]
}